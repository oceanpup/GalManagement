<UserControl x:Class="GalManagement.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- 外观设置 -->
            <Border Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="外观" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="应用显示设置,修改后立即生效。" FontSize="12" Margin="0,4,0,16"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock Text="窗口标题" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBox Style="{StaticResource GlassTextBox}" Width="360" HorizontalAlignment="Left"
                             Text="{Binding AppTitle, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="显示在主窗口左上角与任务栏。" FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <!-- 应用图标 -->
                    <TextBlock Text="应用图标" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                               Margin="0,18,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="56" Height="56"
                                Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8">
                            <Grid>
                                <Image Source="{Binding IconPreviewPath, Converter={StaticResource ImagePath}}"
                                       Stretch="Uniform" Margin="6"/>
                                <TextBlock Text="默认" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                           Visibility="{Binding IconPreviewPath, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GlassButton}" Content="选择图标"
                                        MinWidth="90" MinHeight="36" Padding="0" FontSize="13"
                                        Background="{DynamicResource AccentGlassBrush}"
                                        Command="{Binding PickIconCommand}"/>
                                <Button Style="{StaticResource GlassButton}" Content="恢复默认" Margin="10,0,0,0"
                                        MinWidth="90" MinHeight="36" Padding="0" FontSize="13"
                                        Command="{Binding ResetIconCommand}"/>
                            </StackPanel>
                            <TextBlock Text="显示在窗口标题栏旁与任务栏,支持 PNG / ICO。" FontSize="11" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
