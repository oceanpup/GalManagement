<Window x:Class="GalManagement.Views.GameEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑游戏"
        Width="520" Height="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI">

    <Border CornerRadius="12"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid Margin="36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,32,0">
                    <!-- 封面 -->
                    <Grid Height="170">
                        <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="10">
                            <Image Source="{Binding CoverPreviewPath, Converter={StaticResource ImagePath}}" Stretch="Uniform" Margin="8"/>
                        </Border>
                        <TextBlock Text="暂无封面" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding CoverPreviewPath, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}"/>
                        <Button Style="{StaticResource GlassButton}" Content="选择封面"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"
                                Command="{Binding PickCoverCommand}"/>
                    </Grid>

                    <!-- 缩略图显示范围 -->
                    <TextBlock Text="缩略图显示范围" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="60" Height="80"
                                Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8">
                            <Image Stretch="UniformToFill">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource ThumbnailCrop}">
                                        <Binding Path="CoverPreviewPath"/>
                                        <Binding Path="Current.ThumbOffsetX"/>
                                        <Binding Path="Current.ThumbOffsetY"/>
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="水平位置" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding Current.ThumbOffsetX}" Margin="0,6,0,0"/>
                            <TextBlock Text="垂直位置" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding Current.ThumbOffsetY}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 名称 -->
                    <TextBlock Text="名称" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Style="{StaticResource GlassTextBox}"
                             Text="{Binding Current.Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 评分 -->
                    <TextBlock Text="评分" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Value="{Binding Current.Rating}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" MinWidth="36" TextAlignment="Right"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                                   Text="{Binding Current.Rating, StringFormat={}{0:F1}}"/>
                    </Grid>

                    <!-- 状态 -->
                    <TextBlock Text="状态" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox Style="{StaticResource GlassComboBox}"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding Current.Status}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource StatusToText}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- 开发商 -->
                    <TextBlock Text="开发商" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Style="{StaticResource GlassTextBox}"
                             Text="{Binding Current.Developer, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 标签 -->
                    <TextBlock Text="标签" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource GlassTextBox}"
                                 Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="TagInput_KeyDown"/>
                        <Button Grid.Column="1" Style="{StaticResource GlassButton}" Content="添加" Margin="8,0,0,0"
                                MinWidth="68" MinHeight="42" Padding="0" FontSize="13"
                                Command="{Binding AddTagCommand}"/>
                    </Grid>

                    <ComboBox Style="{StaticResource GlassComboBox}" Margin="0,8,0,0"
                              ItemsSource="{Binding TagSuggestions}"
                              SelectedItem="{Binding SelectedSuggestion}"/>

                    <ItemsControl ItemsSource="{Binding Current.Tags}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource NavActiveBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Button Content="✕" Margin="6,0,0,0" Padding="0" FontSize="11"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 启动路径 -->
                    <TextBlock Text="启动路径" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource GlassTextBox}"
                                 Text="{Binding Current.LaunchPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Style="{StaticResource GlassButton}" Content="选择" Margin="8,0,0,0"
                                MinWidth="68" MinHeight="42" Padding="0" FontSize="13"
                                Command="{Binding PickLaunchCommand}"/>
                    </Grid>

                    <!-- 通关日期 -->
                    <TextBlock Text="通关日期" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <DatePicker Style="{StaticResource GlassDatePicker}" SelectedDate="{Binding Current.CompletedDate}"/>

                    <!-- 时长 -->
                    <TextBlock Text="游玩时长(小时)" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Style="{StaticResource GlassTextBox}"
                             Text="{Binding Current.PlayTimeHours, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 概述 -->
                    <TextBlock Text="概述" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Style="{StaticResource GlassTextBox}" Height="120"
                             Text="{Binding Current.Summary, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource GlassButton}" Content="取消"
                        MinWidth="80" MinHeight="42" Padding="0" FontSize="14"
                        Command="{Binding CancelCommand}"/>
                <Button Style="{StaticResource GlassButton}" Content="保存" Margin="12,0,0,0"
                        MinWidth="80" MinHeight="42" Padding="0" FontSize="14"
                        Background="{DynamicResource AccentGlassBrush}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
