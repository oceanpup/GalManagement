<Window x:Class="GalManagement.Views.SaveSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="云存档"
        Width="480" Height="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI">

    <Border CornerRadius="12"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid Margin="36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding GameName}" FontSize="12" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <!-- 本地 -->
                <TextBlock Text="本地存档" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding LocalText}" FontSize="13" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- 云端 -->
                <TextBlock Text="云端存档" FontSize="12" Margin="0,16,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding RemoteText}" FontSize="13" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- 结论 -->
                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                        Padding="12,10" Margin="0,18,0,0">
                    <TextBlock Text="{Binding StateText}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>

                <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding Status, Converter={StaticResource NullToVisibility}}"/>

                <ProgressBar Height="4" Minimum="0" Maximum="100" IsIndeterminate="True"
                             Margin="0,12,0,0" BorderThickness="0"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GlassButton}" Content="{Binding UploadLabel}"
                            MinWidth="110" MinHeight="42" Padding="0" FontSize="14"
                            Background="{DynamicResource AccentGlassBrush}"
                            Visibility="{Binding ShowUpload, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding UploadCommand}"/>
                    <Button Style="{StaticResource GlassButton}" Content="{Binding DownloadLabel}"
                            Margin="10,0,0,0"
                            MinWidth="130" MinHeight="42" Padding="0" FontSize="14"
                            Background="{DynamicResource AccentGlassBrush}"
                            Visibility="{Binding ShowDownload, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding DownloadCommand}"/>
                    <Button Style="{StaticResource GlassButton}" Content="{Binding SkipLabel}"
                            Margin="10,0,0,0"
                            MinWidth="120" MinHeight="42" Padding="0" FontSize="14"
                            Visibility="{Binding ShowSkip, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding SkipCommand}"/>
                    <Button Style="{StaticResource GlassButton}" Content="关闭"
                            Margin="10,0,0,0"
                            MinWidth="80" MinHeight="42" Padding="0" FontSize="14"
                            Visibility="{Binding ShowClose, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding CloseCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
