<Window x:Class="GalManagement.Views.GameReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="评价"
        Width="480" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI">

    <Border CornerRadius="12"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid Margin="36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,32,0">
                    <!-- 封面 -->
                    <TextBlock Text="封面" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid Height="130">
                        <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="10">
                            <Image Source="{Binding CoverPreviewPath, Converter={StaticResource ImagePath}}" Stretch="Uniform" Margin="8"/>
                        </Border>
                        <TextBlock Text="暂无封面" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding CoverPreviewPath, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}"/>
                        <Button Style="{StaticResource GlassButton}" Content="选择封面"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"
                                Command="{Binding PickCoverCommand}"/>
                    </Grid>

                    <!-- 缩略图显示范围 -->
                    <TextBlock Text="缩略图显示范围" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="60" Height="80"
                                Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8">
                            <Image Stretch="UniformToFill">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource ThumbnailCrop}">
                                        <Binding Path="CoverPreviewPath"/>
                                        <Binding Path="Review.ThumbOffsetX"/>
                                        <Binding Path="Review.ThumbOffsetY"/>
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="水平位置" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding Review.ThumbOffsetX}" Margin="0,6,0,0"/>
                            <TextBlock Text="垂直位置" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding Review.ThumbOffsetY}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 部分名称 -->
                    <TextBlock Text="部分名称" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Style="{StaticResource GlassTextBox}"
                             Text="{Binding Review.Title, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 打分 -->
                    <TextBlock Text="打分" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Value="{Binding Review.Rating}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" MinWidth="36" TextAlignment="Right"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                                   Text="{Binding Review.Rating, StringFormat={}{0:F1}}"/>
                    </Grid>

                    <!-- 评价 -->
                    <TextBlock Text="评价" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Style="{StaticResource GlassTextBox}" Height="120"
                             Text="{Binding Review.Comment, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource GlassButton}" Content="取消"
                        MinWidth="80" MinHeight="42" Padding="0" FontSize="14"
                        Command="{Binding CancelCommand}"/>
                <Button Style="{StaticResource GlassButton}" Content="保存" Margin="12,0,0,0"
                        MinWidth="80" MinHeight="42" Padding="0" FontSize="14"
                        Background="{DynamicResource AccentGlassBrush}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
