<Window x:Class="GalManagement.Views.GameDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏详情"
        Width="720" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI">

    <Border CornerRadius="12"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="100" Height="140"
                        Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8">
                    <Image Source="{Binding Game.CoverFullPath, Converter={StaticResource ImagePath}}"
                           Stretch="Uniform" Margin="4"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Game.Name}" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Background="{Binding OverallRating, Converter={StaticResource RatingToBrush}}"
                                CornerRadius="4" Padding="8,2">
                            <TextBlock Text="{Binding OverallRating, StringFormat={}总体评分 {0:F1}}"
                                       Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="{Binding Game.Status, Converter={StaticResource StatusToBrush}}"
                                CornerRadius="4" Padding="8,2" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Game.Status, Converter={StaticResource StatusToText}}"
                                       Foreground="#FFFFFF" FontSize="13"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 评价列表 -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="分项评价" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource GlassButton}" Content="+ 添加评价" Margin="12,0,0,0"
                            MinWidth="96" MinHeight="34" Padding="0" FontSize="13"
                            Background="{DynamicResource AccentGlassBrush}"
                            Command="{Binding AddReviewCommand}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="暂无评价" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"
                           Visibility="{Binding HasReviews, Converter={StaticResource InverseBoolToVisibility}}"/>

                <ListBox Grid.Row="1" x:Name="ReviewList" ItemsSource="{Binding Reviews}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AllowDrop="True"
                         DragOver="ReviewList_DragOver"
                         Drop="ReviewList_Drop"
                         Visibility="{Binding HasReviews, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="30" Margin="2,0,10,0"
                                        VerticalAlignment="Stretch" Cursor="SizeAll"
                                        ToolTip="按住拖动可调整顺序"
                                        PreviewMouseLeftButtonDown="Handle_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="Handle_PreviewMouseMove">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="CornerRadius" Value="4"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="⠿" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>

                                <Border Grid.Column="1" Width="44" Height="60"
                                        Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6">
                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource ThumbnailCrop}">
                                                <Binding Path="CoverFullPath"/>
                                                <Binding Path="ThumbOffsetX"/>
                                                <Binding Path="ThumbOffsetY"/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                </Border>

                                <Border Grid.Column="2" Background="{Binding Rating, Converter={StaticResource RatingToBrush}}"
                                        CornerRadius="4" Padding="6,2" VerticalAlignment="Top" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}"
                                               Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                                </Border>

                                <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Comment}" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                               Visibility="{Binding Comment, Converter={StaticResource NullToVisibility}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Style="{StaticResource GlassButton}" Content="编辑"
                                            MinWidth="56" MinHeight="30" Padding="0" FontSize="12"
                                            Background="{DynamicResource AccentGlassBrush}"
                                            Command="{Binding DataContext.EditReviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource GlassButton}" Content="删除" Margin="8,0,0,0"
                                            MinWidth="56" MinHeight="30" Padding="0" FontSize="12"
                                            Background="{DynamicResource DangerGlassBrush}"
                                            Command="{Binding DataContext.DeleteReviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 底部 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource GlassButton}" Content="关闭"
                        MinWidth="90" MinHeight="42" Padding="0" FontSize="14"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
