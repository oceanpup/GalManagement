<Window x:Class="GalManagement.Views.BaiduAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="绑定百度网盘"
        Width="440" Height="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI">

    <Border CornerRadius="12"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid Margin="36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="绑定百度网盘" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Text="在授权页输入下面的用户码:" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <!-- 用户码:可选中复制 -->
                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="10"
                        Margin="0,10,0,0" Padding="0,14">
                    <TextBox Text="{Binding UserCode}" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0"
                             TextAlignment="Center" FontSize="26" FontWeight="SemiBold"
                             Cursor="IBeam"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>

                <TextBlock Text="用户码有时效;过期后关掉本窗口重新绑定即可。"
                           FontSize="11" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <ProgressBar Height="4" Minimum="0" Maximum="100" IsIndeterminate="True"
                             Margin="0,12,0,0" BorderThickness="0"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource GlassButton}" Content="复制并打开授权页"
                        MinWidth="150" MinHeight="42" Padding="0" FontSize="14"
                        Background="{DynamicResource AccentGlassBrush}"
                        Command="{Binding CopyAndOpenCommand}"/>
                <Button Style="{StaticResource GlassButton}" Content="关闭" Margin="12,0,0,0"
                        MinWidth="80" MinHeight="42" Padding="0" FontSize="14"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
