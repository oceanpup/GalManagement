<Window x:Class="GalManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GalManagement.Views"
        xmlns:vm="clr-namespace:GalManagement.ViewModels"
        Title="{Binding AppSettings.AppTitle}"
        Icon="{Binding IconFullPath, Converter={StaticResource ImagePath}}"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:GameLibraryViewModel}">
            <views:GameLibraryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsViewModel}">
            <views:StatsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <!-- 背景图 + 遮罩 -->
            <Image Source="{Binding BackgroundPath, Converter={StaticResource ImagePath}}" Stretch="UniformToFill"/>
            <Border Background="{DynamicResource OverlayBrush}"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Image Source="{Binding IconFullPath, Converter={StaticResource ImagePath}}"
                               Width="18" Height="18" Stretch="Uniform"
                               Visibility="{Binding IconFullPath, Converter={StaticResource NullToVisibility}}"/>
                        <TextBlock Text="{Binding AppSettings.AppTitle}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                Margin="0,0,12,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource GlassIconButton}" Content="壁纸" FontSize="11"
                                ToolTip="更换壁纸" Command="{Binding ChangeBackgroundCommand}"/>
                        <Button Style="{StaticResource GlassIconButton}" Content="主题" FontSize="11"
                                ToolTip="切换主题" Command="{Binding ToggleThemeCommand}"/>
                        <Button Style="{StaticResource GlassIconButton}" Content="─"
                                ToolTip="最小化" Click="Minimize_Click"/>
                        <Button Style="{StaticResource GlassIconButton}" Content="□"
                                ToolTip="最大化/还原" Click="Maximize_Click"/>
                        <Button Style="{StaticResource GlassIconButton}" Content="✕"
                                ToolTip="关闭" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 内容:导航 + 视图 -->
                <Grid Grid.Row="1" Margin="16,0,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav"
                                     Content="游戏库" IsChecked="True"
                                     Command="{Binding ShowLibraryCommand}"/>
                        <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav"
                                     Content="统计" Margin="0,4,0,0"
                                     Command="{Binding ShowStatsCommand}"/>
                        <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav"
                                     Content="设置" Margin="0,4,0,0"
                                     Command="{Binding ShowSettingsCommand}"/>
                    </StackPanel>

                    <ContentControl Grid.Column="2" Content="{Binding CurrentView}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
