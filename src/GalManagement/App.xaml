<Application x:Class="GalManagement.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GalManagement.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/GlassStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:GameStatusToTextConverter x:Key="StatusToText"/>
            <conv:GameStatusToBrushConverter x:Key="StatusToBrush"/>
            <conv:RatingToBrushConverter x:Key="RatingToBrush"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <conv:ImagePathConverter x:Key="ImagePath"/>
            <conv:ThumbnailCropConverter x:Key="ThumbnailCrop"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <conv:InverseBooleanConverter x:Key="InverseBool"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
